# Licensed market data never enters git: real data lives outside the repository
# under FEFAT_DATA_DIR. Only generated fixtures under fixtures/synthetic/ are
# committed. The commit guard (scripts/guard_data.py, run by .githooks/pre-commit
# and pre-push) also catches forced adds, and data saved under other names.

# --- Market data and other data files -----------------------------------------
*.dbn
*.dbn.zst
*.zst
*.parquet
*.arrow
*.arrows
*.feather
*.ipc
*.csv.gz
*.zip
*.h5
*.hdf5
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
# plain-text tables, spreadsheets, archives, and compressors (D-48)
*.csv
*.tsv
*.jsonl
*.ndjson
*.xls
*.xlsx
*.gz
*.tar
*.7z
*.xz
*.bz2
*.lz4
# the platforms' own history files: NinjaTrader 8 and Sierra Chart
*.ncd
*.scid
# ...except generated synthetic fixtures (each listed in its MANIFEST.json)
!fixtures/synthetic/**

# --- Secrets ------------------------------------------------------------------
.env
.env.*
.envrc
*.env
!.env.example
*.pem
*.key
*.pfx
*.p12

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
# the engine extension when `maturin develop` builds it in place
*.pyd
*.so

# --- Rust ---------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb

# --- Node and web -------------------------------------------------------------
node_modules/
.pnpm-store/
*.tsbuildinfo
.vite/
dev-dist/
coverage/
playwright-report/
test-results/
blob-report/

# --- Claude Code: personal files (shared config under .claude/ is committed) --
.claude/settings.local.json
CLAUDE.local.md

# --- Editors and operating systems --------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Logs and scratch ---------------------------------------------------------
*.log
logs/
tmp/
.tmp/
scratch/
