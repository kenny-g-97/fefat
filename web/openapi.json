{
  "components": {
    "schemas": {
      "ApiToken": {
        "description": "An API token of a notebook or a script, by its name, kept only as its SHA-256, which\nnames it, with when it was made and last used.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "created_at",
          "last_used_at"
        ],
        "title": "ApiToken",
        "type": "object"
      },
      "ApiTokenIdentity": {
        "description": "A request of an API token, by the token's name; it needs no CSRF token, since a browser\nnever sends a bearer token by itself.",
        "properties": {
          "kind": {
            "const": "api_token",
            "default": "api_token",
            "title": "Kind",
            "type": "string"
          },
          "token_name": {
            "title": "Token Name",
            "type": "string"
          }
        },
        "required": [
          "token_name"
        ],
        "title": "ApiTokenIdentity",
        "type": "object"
      },
      "ApiTokenRequest": {
        "additionalProperties": false,
        "description": "The name of a new API token, such as `notebook`.",
        "properties": {
          "name": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ApiTokenRequest",
        "type": "object"
      },
      "AppSettings": {
        "description": "The settings the page shows: the server's, from `config.toml`, the data folder, the\ntheme, and each secret's state.",
        "properties": {
          "data_dir": {
            "format": "path",
            "title": "Data Dir",
            "type": "string"
          },
          "secrets": {
            "items": {
              "$ref": "#/components/schemas/SecretStatus"
            },
            "title": "Secrets",
            "type": "array"
          },
          "server": {
            "$ref": "#/components/schemas/Settings"
          },
          "theme": {
            "$ref": "#/components/schemas/Theme"
          }
        },
        "required": [
          "server",
          "data_dir",
          "theme",
          "secrets"
        ],
        "title": "AppSettings",
        "type": "object"
      },
      "FieldError": {
        "description": "Where a request broke the API's schema and why, without the value it sent.",
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Health": {
        "description": "The server answers.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "IssuedApiToken": {
        "description": "A new API token under its name, which this response alone carries.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "name",
          "token"
        ],
        "title": "IssuedApiToken",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "The password, set at `fefat up`'s first run or by `fefat password set`.",
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "PasswordChange": {
        "additionalProperties": false,
        "description": "The password the session's login used, and the one to keep in its place.",
        "properties": {
          "current_password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Current Password",
            "type": "string",
            "writeOnly": true
          },
          "new_password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 8,
            "title": "New Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange",
        "type": "object"
      },
      "Problem": {
        "description": "An error the API answered (RFC 9457), with the id of the request it ended.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "SecretChanges": {
        "additionalProperties": {
          "anyOf": [
            {
              "format": "password",
              "minLength": 1,
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ]
        },
        "propertyNames": {
          "$ref": "#/components/schemas/SecretName"
        },
        "type": "object"
      },
      "SecretName": {
        "description": "The secrets FEFAT keeps, each the key of a service it calls: the agent's model provider\n(Phase 8) and a market data vendor (D-37). The list is closed, since a credential store\ncannot list what it holds; a step that calls another service adds its name.",
        "enum": [
          "anthropic",
          "databento"
        ],
        "title": "SecretName",
        "type": "string"
      },
      "SecretState": {
        "description": "Whether the credential store holds a secret.",
        "enum": [
          "stored",
          "missing"
        ],
        "title": "SecretState",
        "type": "string"
      },
      "SecretStatus": {
        "description": "A secret by its name, with whether it is stored, never with its value.",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/SecretName"
          },
          "state": {
            "$ref": "#/components/schemas/SecretState"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "title": "SecretStatus",
        "type": "object"
      },
      "SessionIdentity": {
        "description": "A request of a login session, with the CSRF token that every state-changing request the\nsession's cookie authenticates must carry in `X-CSRF-Token`, and when the session ends.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "kind": {
            "const": "session",
            "default": "session",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "expires_at",
          "csrf_token"
        ],
        "title": "SessionIdentity",
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "description": "What the server needs before its database opens, from `<FEFAT_HOME>/config.toml`\n(`01-architecture.md` sections 4, 6, and 8, D-83): the port it listens on, the address it\nbinds, which can only be the loopback (D-54), the size of its process pool, and the folders\nan import may read large files from. What the app edits, such as the password and the\ntheme, lives in its database's `settings` table instead; secrets live in the credential\nstore, never here.",
        "properties": {
          "bind_address": {
            "const": "127.0.0.1",
            "default": "127.0.0.1",
            "title": "Bind Address",
            "type": "string"
          },
          "import_roots": {
            "default": [],
            "items": {
              "format": "path",
              "type": "string"
            },
            "title": "Import Roots",
            "type": "array"
          },
          "port": {
            "default": 8765,
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "type": "integer"
          },
          "process_pool_size": {
            "minimum": 1.0,
            "title": "Process Pool Size",
            "type": "integer"
          }
        },
        "title": "Settings",
        "type": "object"
      },
      "SettingsChange": {
        "additionalProperties": false,
        "description": "A change of the settings: a secret named with a value stores it, one named with null\nremoves it, and one left out stays as it is; a theme, when given, replaces the theme.",
        "properties": {
          "secrets": {
            "$ref": "#/components/schemas/SecretChanges"
          },
          "theme": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Theme"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "SettingsChange",
        "type": "object"
      },
      "Theme": {
        "description": "The web app's colours (`web/DESIGN.md`): dark, the default the design brief sets, or\nlight.",
        "enum": [
          "dark",
          "light"
        ],
        "title": "Theme",
        "type": "string"
      },
      "ValidationProblem": {
        "description": "A request the API's schema refused, with each of its errors.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "request_id",
          "errors"
        ],
        "title": "ValidationProblem",
        "type": "object"
      },
      "Versions": {
        "description": "The versions the server runs: the app's, the SDK's, and the engine's three, which every\nrun records (`02-engine-and-data.md` section 4).",
        "properties": {
          "artifact_schema": {
            "title": "Artifact Schema",
            "type": "integer"
          },
          "engine": {
            "title": "Engine",
            "type": "integer"
          },
          "fefat": {
            "title": "Fefat",
            "type": "string"
          },
          "fefat_app": {
            "title": "Fefat App",
            "type": "string"
          },
          "fill_model": {
            "title": "Fill Model",
            "type": "integer"
          }
        },
        "required": [
          "fefat_app",
          "fefat",
          "engine",
          "fill_model",
          "artifact_schema"
        ],
        "title": "Versions",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiToken": {
        "description": "An API token of `fefat token create`, for notebooks and scripts.",
        "scheme": "bearer",
        "type": "http"
      },
      "CsrfToken": {
        "description": "The `csrf_token` of `POST /v1/auth/login` or `GET /v1/me`, which every request that changes state must carry when the session's cookie authenticates it.",
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "Session": {
        "description": "The login session's cookie, which `POST /v1/auth/login` sets.",
        "in": "cookie",
        "name": "fefat_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "FEFAT's local server: its API, for the web app, notebooks, and scripts.",
    "title": "FEFAT",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/api-tokens": {
      "get": {
        "description": "The API tokens not revoked, by when they were made, with when each was last used, never\na token.",
        "operationId": "live_api_tokens_v1_api_tokens_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ApiToken"
                  },
                  "title": "Response Live Api Tokens V1 Api Tokens Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "ApiToken": []
          },
          {
            "Session": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Live Api Tokens",
        "tags": [
          "api tokens"
        ]
      },
      "post": {
        "description": "Make an API token, shown in this response alone; refused with 409 for a name a token\nhas or had.",
        "operationId": "create_api_token_v1_api_tokens_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedApiToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "ApiToken": []
          },
          {
            "Session": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Create Api Token",
        "tags": [
          "api tokens"
        ]
      }
    },
    "/v1/api-tokens/{name}": {
      "delete": {
        "description": "Revoke the live API token `name`, which every request refuses from then on; refused with\n404 where no live token has the name.",
        "operationId": "revoke_api_token_v1_api_tokens__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "ApiToken": []
          },
          {
            "Session": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Revoke Api Token",
        "tags": [
          "api tokens"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "description": "Log in with the password: the response sets the cookie of a session of 30 days and\nreturns its CSRF token; refused with 401 for a wrong password, and with 429 after five\nattempts in a minute.",
        "operationId": "login_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionIdentity"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Login",
        "tags": [
          "login"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "End the session the cookie names, whether the cookie or an API token authenticates the\nrequest, and clear the cookie.",
        "operationId": "logout_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "ApiToken": []
          },
          {
            "Session": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "login"
        ]
      }
    },
    "/v1/auth/password": {
      "post": {
        "description": "Change the password, from a login session alone: every session ends, and the response\nsets the cookie of a new one for this browser and returns its CSRF token; refused with 403\nfor a wrong current password, and with 429 after five attempts in a minute, the logins'\nattempts included.",
        "operationId": "change_password_v1_auth_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionIdentity"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "ApiToken": []
          },
          {
            "Session": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Change Password",
        "tags": [
          "login"
        ]
      }
    },
    "/v1/healthz": {
      "get": {
        "description": "Whether the server answers; no login needed.",
        "operationId": "health_v1_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Who the request comes from: a login session, with its CSRF token and when it ends, or\nan API token, by its name.",
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "api_token": "#/components/schemas/ApiTokenIdentity",
                      "session": "#/components/schemas/SessionIdentity"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SessionIdentity"
                    },
                    {
                      "$ref": "#/components/schemas/ApiTokenIdentity"
                    }
                  ],
                  "title": "Response Me V1 Me Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "ApiToken": []
          },
          {
