  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-file-paths.mjs"
            ],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking the file path"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell-commands.mjs"
            ],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking the command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.mjs"
            ],
            "timeout": 20,
            "onFailure": "continue",
            "statusMessage": "Formatting the file"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-brief.mjs"
            ],
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@anthropic-plugin-directory": true,
    "pyright-lsp@anthropic-plugin-directory": true,
    "typescript-lsp@anthropic-plugin-directory": true
  }
}
